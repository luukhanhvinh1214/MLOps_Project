# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN MLOPS AI QA CHATBOT
# Hãy sao chép tệp này thành .env và điền thông tin thực tế trước khi khởi chạy
# ==============================================================================

# 1. Cấu hình OpenAI API
# Lấy API Key tại: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# 2. Cấu hình Mô hình Ngôn ngữ & Embedding
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# 3. Cấu hình Máy chủ Backend FastAPI
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8085

# 4. Cấu hình Đường dẫn Dữ liệu & Nhật ký
# Đối với môi trường Docker: /app/logs
# Đối với môi trường cục bộ: ./logs
LOG_DIR=./logs
VECTOR_DB_PATH=./data/vector_db_path
CHAT_SESSION_DIR=./data/chat_sessions
