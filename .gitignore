# ==========================================
# Cấu hình bảo mật: Biến môi trường & Bí mật
# ==========================================
.env
.env.*
!.env.example
!*.env.example
*.key
*.pem
*.crt
*.pfx
*.cert
id_rsa*
credentials.json
service_account*.json

